# ============================================================
# WomenSafetyApp Frontend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# Backend API URL (used by apiConfig.ts / src/api/config.ts)
# For local dev, point at your own machine (see .env for the LAN-IP / emulator notes).
# For the shared deployed backend, use the API Gateway endpoint - NOT the Lambda Function
# URL, which currently 403s on anonymous requests (see DEPLOY.md):
#   EXPO_PUBLIC_API_URL=https://ywrqvm9zn0.execute-api.ap-south-1.amazonaws.com
EXPO_PUBLIC_API_URL=http://127.0.0.1:8001
# Optional override for backend URL (e.g. http://192.168.1.23:8000/api/v1)
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Public live-tracking web page (Firebase Hosting URL for web/track.html).
# Deploy with: firebase deploy --only hosting
# Then paste the resulting https://<project>.web.app URL here.
EXPO_PUBLIC_TRACKING_BASE_URL=https://your-project.web.app

# Supabase Configuration (used by supabaseClient.ts, env.config.ts, and src/data/supabase.ts)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Firebase Configuration (used by env.config.ts and firebaseAuthService.ts)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id

# Gemini AI Configuration (used by geminiService.ts)
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key

# Sentry error/performance monitoring (org: womensafetyapp, project: react-native).
# DSN is public-safe (not a secret) — used by App.tsx's Sentry.init().
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_KEY@oYOUR_ORG_ID.ingest.us.sentry.io/YOUR_PROJECT_ID
# Only needed for uploading source maps/debug symbols during native builds — never commit
# a real value; set as a CI/EAS secret, not here.
# SENTRY_AUTH_TOKEN=
