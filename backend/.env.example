# Project & Server Configuration
PROJECT_NAME="Aegis AI Women Safety Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Firebase Configuration
# IMPORTANT: FIREBASE_PROJECT_ID and the service-account JSON must match the mobile app's
# Firebase project (see frontend/google-services.json → project_info.project_id).
FIREBASE_PROJECT_ID=women-safety-3d446
FIREBASE_STORAGE_BUCKET=women-safety-3d446.appspot.com
FIREBASE_SERVICE_ACCOUNT_PATH=credentials/firebase-service-account.json
# Serverless environments (e.g. Lambda) set the service-account JSON content directly instead of
# a file path - see FIREBASE_SERVICE_ACCOUNT_PATH above for local dev. Leave unset locally.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Database & Supabase Configuration
# NEVER put real values below in this file - it's an example/template and is committed to git.
# Put real values in backend/.env instead (gitignored).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key-here
APP_SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./women_safety.db

# Sentry Error & Performance Tracking
SENTRY_DSN=https://beda47cfdbf07ea0d0b31194a15db38d@o4511977779036161.ingest.us.sentry.io/4511977828974592
SENTRY_TRACES_SAMPLE_RATE=1.0

