# ---- OS / editor ----
.DS_Store
*.swp
Thumbs.db
~$*

# ---- Local databases (dev DBs must never be committed - contain user/PII data) ----
*.db
*.sqlite
*.sqlite3

# ---- Secrets / env ----
.env
.env.*
!.env.example

# ---- Supabase (CLI generated) ----
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/logs/

# ---- Node ----
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*

# ---- Deno (backend) ----
# deno.lock is committed; ignore local caches only
.deno/

# ---- IDE ----

.idea/
backend/credentials/firebase-service-account.json
# ---- Agent & Tooling Artifacts ----
.agents/
.claude/
